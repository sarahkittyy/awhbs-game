# awhbs-server configuration. Copy to .env; the server reads it from the working directory.
# Production keeps its own copy at /srv/awhbs/.env (AWHBS_TRUST_PROXY=true behind nginx).

# Address the server binds. Behind nginx keep it on loopback.
AWHBS_HOST=127.0.0.1
AWHBS_PORT=3547
# MariaDB (docker-compose.yml starts one with these credentials).
DATABASE_URL=mysql://root:pawsword@127.0.0.1:3306/awhbs
# Signs run tokens and salts stored IP hashes. Any long random string: openssl rand -hex 32
AWHBS_SECRET=change-me
# Behind a reverse proxy that sets X-Real-IP, key rate limits by it. Never true without one.
AWHBS_TRUST_PROXY=false
# false only for local testing.
AWHBS_RATE_LIMITS=true
# Local development only: also serve the web build from this directory (production uses nginx).
AWHBS_STATIC=dist
RUST_LOG=info,sqlx=warn
